# Alka Refrigeration 2.0 - Environment Variables Example
# Duplicate this file as .env.local and fill in your values

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/alka-refrigeration?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxx

NEXT_PUBLIC_APP_URL=http://localhost:3000
