# Alka Refrigeration 2.0 - Environment Variables Example
# Duplicate this file as .env.local and fill in your values

# -------------------------------------------------------------
# DATABASE & SESSIONS
# -------------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/alka-refrigeration?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# -------------------------------------------------------------
# GOOGLE OAUTH 2.0
# Add http://localhost:3000 to Authorized JavaScript origins
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# -------------------------------------------------------------
# ADMINISTRATOR ROLE
# -------------------------------------------------------------
ADMIN_EMAIL=refrigerationalka@gmail.com
NEXT_PUBLIC_ADMIN_EMAIL=refrigerationalka@gmail.com

# -------------------------------------------------------------
# PAYMENT GATEWAY (RAZORPAY)
# -------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxx

# -------------------------------------------------------------
# APP URL
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------------------------
# EMAIL OTP CONFIGURATION (NODEMAILER / SMTP)
# (If not provided, test OTPs are securely logged to the console)
# -------------------------------------------------------------
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email@gmail.com
EMAIL_SERVER_PASSWORD=your_gmail_app_password
EMAIL_FROM="Alka Refrigeration <noreply@alkarefrigeration.com>"

# -------------------------------------------------------------
# SMS OTP CONFIGURATION (OPTIONAL: TWILIO OR FAST2SMS)
# (If not provided, test OTPs are logged to the console)
# -------------------------------------------------------------
# Option A: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option B: Fast2SMS (Indian SMS Gateway)
FAST2SMS_API_KEY=
